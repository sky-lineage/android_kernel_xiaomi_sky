# NTFS
CONFIG_NTFS_FS=y
CONFIG_NTFS_RW=y
# KMSG
CONFIG_QCOM_MINIDUMP_LAST_KMSG=y
# SimTray
CONFIG_SIMTRAY_STATUS=m
# Touchscreen
CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=m
CONFIG_TOUCHSCREEN_FT8720=m
CONFIG_TOUCHSCREEN_NT36672C_SPI=m
CONFIG_XIAOMI_TOUCH_NOTIFIER=m
CONFIG_XIAOMI_PANEL_NOTIFIER=m
CONFIG_XIAOMI_USB_TOUCH_NOTIFIER=m
CONFIG_XIAOMI_HEADSET_TOUCH_NOTIFIER=m
CONFIG_KTD3136_BL=m
CONFIG_OCP2131_BIAS=m
# USB
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_LAN78XX=m
# IR
CONFIG_IR_SPI=m
CONFIG_LIRC=y
CONFIG_RC_CORE=y
CONFIG_RC_DECODERS=y
CONFIG_RC_DEVICES=y
# UFS
CONFIG_MI_MEMORY_SYSFS=m
CONFIG_UFS_WB=y
CONFIG_UFSGKI=y
CONFIG_CLD=y
# Thermal
CONFIG_MI_THERMAL_INTERFACE=m
